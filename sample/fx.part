// ---------- alarm clock ----------
function clock(cx,cy,r,rot,st={}){const sd=60;ctx.save();ctx.translate(cx,cy);ctx.rotate(rot);ctx.scale(st.sx||1,st.sy||1);
  const kick=st.kick||0;
  // legs
  brush([[-r*.5,r*.82],[-r*.62+kick*20,r*1.12],[-r*.78+kick*30,r*1.36]],11,{seed:sd+1,flat:1});
  brush([[r*.5,r*.82],[r*.6-kick*24,r*1.16],[r*.72-kick*12,r*1.36]],11,{seed:sd+2,flat:1});
  // bells + hammer
  [-1,1].forEach((s,i)=>{ctx.save();ctx.translate(s*r*.62,-r*.86);ctx.rotate(s*.5+(st.bell||0)*s);fillShape(ring(0,0,r*.36,r*.3,10,0).map(p=>[p[0],Math.min(p[1],r*.08)]),C.red,sd+3+i);
     brush(ring(0,0,r*.36,r*.3,10,0).map(p=>[p[0],Math.min(p[1],r*.08)]),6,{closed:true,seed:sd+5+i});ctx.restore()});
  brush([[0,-r],[0,-r*1.2]],8,{seed:sd+7,flat:1});blob(0,-r*1.24,9,9,C.ink,1,sd+8);
  // arms
  if(st.arm!==undefined){const a=st.arm;brush([[-r*.92,r*.1],[-r*1.25,r*(.1-a*.5)],[-r*1.45,r*(-.2-a*.9)]],9,{seed:sd+9,flat:1});blob(-r*1.47,r*(-.24-a*.9),12,12,C.gi,4,sd+10)}
  // body
  blob(0,0,r,r,C.yel,7,sd+11);blob(0,0,r*.74,r*.74,C.gi,5,sd+12);
  for(let k=0;k<12;k++){const a=k/12*Math.PI*2;brush([[Math.cos(a)*r*.6,Math.sin(a)*r*.6],[Math.cos(a)*r*.68,Math.sin(a)*r*.68]],k%3?3:5,{seed:sd+20+k,amp:.6})}
  // face
  const e=st.eyes||'open';
  if(e==='x'){[[-24,-12],[24,-12]].forEach((p,i)=>{brush([[p[0]-12,p[1]-12],[p[0]+12,p[1]+12]],6,{seed:sd+30+i});brush([[p[0]+12,p[1]-12],[p[0]-12,p[1]+12]],6,{seed:sd+32+i})});
    brush([[-26,34],[-8,28],[8,36],[26,28]],5,{seed:sd+35})}
  else{const big=e==='bulge'?1.45:1;[[-25,-10],[25,-10]].forEach((p,i)=>{blob(p[0],p[1],15*big,18*big,'#fff',4.5,sd+36+i);blob(p[0]+(e==='bulge'?0:6)+nz(3,i,1)*(e==='bulge'?2:0),p[1]+2,6,7,C.ink,1,sd+38+i)});
    if(e==='bulge'){blob(0,36,16,13,C.red,5,sd+40)}else{fillShape([[-24,26],[24,26],[14,46],[-14,46]],C.red,sd+41);brush([[-26,26],[26,26],[14,46],[-14,46]],5,{closed:true,seed:sd+42})}}
  ctx.restore()}

// ---------- cel FX ----------
function star(cx,cy,r,u,sd){if(u<=0||u>=1)return;const s=u<.25?eo(u/.25):1-ei((u-.25)/.75)*.9,n=11,P=[];
  for(let i=0;i<n*2;i++){const a=i/(n*2)*Math.PI*2+sd,rr=(i%2?r*.42:r*(.8+.35*hash(i+sd)))*s;P.push([cx+Math.cos(a)*rr,cy+Math.sin(a)*rr])}
  fillShape(P,C.yel,sd);brush(P,6,{closed:true,seed:sd+1,sub:2});const Q=P.map(p=>L2([cx,cy],p,.55));fillShape(Q,C.red,sd+2);
  if(u>.4){ctx.fillStyle=C.paper;ctx.beginPath();poly(ring(cx,cy,r*(u-.4)*1.6,r*(u-.4)*1.6,12));ctx.fill()}}
function puff(cx,cy,u,dir,sd,sc=1){if(u<=0||u>=1)return;const n=6;
  for(let i=0;i<n;i++){const a=(i/n)*Math.PI*2+sd,d=(30+90*eo(u))*sc*(0.7+.5*hash(i+sd)),px=cx+Math.cos(a)*d*1.3+dir*u*60*sc,py=cy+Math.sin(a)*d*.55-u*70*sc*hash(i*3+sd);
    const r=(48*Math.sin(Math.min(u*1.6,1)*Math.PI*.5)*(1-u*.85)+6)*sc*(.7+.6*hash(i+sd*2));
    if(u<.6)blob(px,py,r,r*.92,C.gi,5,sd+i);else{brush(ring(px,py,r,r,9,a).slice(0,6),5*(1-u)+1.5,{seed:sd+i})}
    if(u>.35&&u<.8)brush([[px+r*.2,py-r*.1],[px+r*.45,py+r*.2],[px+r*.1,py+r*.35]],3,{seed:sd+i+20})}}
function sparkle(x,y,s,sd){if(s<=0)return;const P=[];for(let i=0;i<8;i++){const a=i/8*Math.PI*2,r=(i%2?.22:1)*s;P.push([x+Math.cos(a)*r,y+Math.sin(a)*r])}fillShape(P,C.yel,sd);brush(P,4,{closed:true,seed:sd+1,sub:2})}
function speed(x0,x1,y,w,sd){brush([[x0,y],[lerp(x0,x1,.5),y+nz(sd,1,1)*4],[x1,y]],w,{seed:sd})}
function ringLines(cx,cy,r,sd){for(const s of[-1,1])for(let k=0;k<3;k++){const rr=r+30+k*28,a0=s>0?-.55:Math.PI-.55+0;const P=[];for(let j=0;j<5;j++){const a=(s>0?-.5:Math.PI+.5)+(s>0?1:-1)*j*.25;P.push([cx+Math.cos(a)*rr,cy+Math.sin(a)*rr*.95])}brush(P,7-k,{seed:sd+k+s*10})}}
function drop(x,y,s,sd){const P=[[x,y-22*s],[x+12*s,y],[x,y+10*s],[x-12*s,y]];fillShape(P,'#9FD3E8',sd);brush(P,4,{closed:true,seed:sd+1})}

